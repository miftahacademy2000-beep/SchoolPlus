generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DB_URL")
}

model School {
  id                      String                    @id @default(uuid()) @db.Char(36)
  name                    String                    @db.VarChar(18)
  slug                    String                    @db.VarChar(14)
  logoUrl                 String                    @map("logo_url") @db.VarChar(139)
  address                 String?                   @db.VarChar(9)
  phone                   String?                   @db.VarChar(14)
  email                   String                    @db.VarChar(27)
  website                 String?                   @db.Text
  status                  String                    @db.VarChar(7)
  plan                    String                    @db.VarChar(10)
  createdBy               String?                   @map("created_by") @db.Char(36)
  createdAt               DateTime                  @map("created_at") @db.DateTime(0)
  updatedAt               DateTime                  @updatedAt @map("updated_at") @db.DateTime(0)
  monthlyFee              Decimal?                  @map("monthly_fee") @db.Decimal(14, 2)
  brand_color             String                    @db.VarChar(7)
  department_type         String                    @db.VarChar(8)
  is_enabled              Boolean
  currency                String                    @db.VarChar(3)
  stamp_url               String?                   @db.VarChar(140)
  academic_years          academic_years[]
  account_reconciliations account_reconciliations[]
  account_transfers       account_transfers[]
  archived_users          ArchivedUser[]
  audit_logs              AuditLog[]
  class_fees              class_fees[]
  classes                 Class[]
  courses                 Course[]
  exam_types              exam_types[]
  exams                   exams[]
  expense_budgets         expense_budgets[]
  expense_categories      expense_categories[]
  expense_settings        expense_settings?
  expenses                expenses[]
  financial_accounts      financial_accounts[]
  grading_scales          grading_scales[]
  invoice_counters        InvoiceCounter?
  invoice_job_runs        invoice_job_runs[]
  invoice_templates       InvoiceTemplate[]
  invoices                Invoice[]
  invoiceRefunds          InvoiceRefund[]
  memberships             Membership[]
  messages                messages[]
  monthly_closings        monthly_closings[]
  parents                 Parent[]
  payment_history         PaymentHistory[]
  recurring_expenses      recurring_expenses[]
  student_fee_overrides   StudentFeeOverride[]
  students                Student[]
  subjects                subjects[]
  subscription_payments   SubscriptionPayment[]
  teachers                Teacher[]
  terms                   terms[]
  user_roles              UserRole[]

  @@map("schools")
}

model Profile {
  id                 String                 @id @db.Char(36)
  fullName           String                 @map("full_name") @db.VarChar(31)
  email              String?                @db.VarChar(38)
  loginId            String?                @unique(map: "profiles_login_id_key") @map("login_id") @db.VarChar(50)
  avatarUrl          String?                @map("avatar_url") @db.VarChar(137)
  phone              String?                @map("phone") @db.VarChar(26)
  createdAt          DateTime               @map("created_at") @db.DateTime(0)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.DateTime(0)
  mustChangePassword Boolean                @map("must_change_password")
  preferredLanguage  String                 @map("preferred_language") @db.VarChar(2)
  passwordHash       String?                @map("password_hash") @db.VarChar(255)
  preferences        String?                @db.LongText
  submissionsGraded  AssignmentSubmission[] @relation("SubmissionGradedBy")
  attendanceMarked   Attendance[]           @relation("AttendanceMarkedBy")
  gradesGraded       Grade[]                @relation("GradeGradedBy")
  messages           messages[]
  parents            Parent[]
  invoiceRefunds     InvoiceRefund[]       @relation("RefundRecordedBy")
  cancelledInvoices  Invoice[]             @relation("InvoiceCancelledBy")
  paymentHistory     PaymentHistory[]       @relation("PaymentRecordedBy")
  students           Student[]
  teachers           Teacher[]

  @@map("profiles")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  role      String   @db.VarChar(12)
  schoolId  String?  @map("school_id") @db.Char(36)
  createdAt DateTime @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)
  schools   School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_user_roles_school_id")

  @@index([schoolId], map: "idx_user_roles_school_id")
  @@map("user_roles")
}

model Membership {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  schoolId  String   @map("school_id") @db.Char(36)
  isActive  Boolean  @map("is_active")
  createdAt DateTime @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)
  schools   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_memberships_school_id")

  @@index([schoolId], map: "idx_memberships_school_id")
  @@map("memberships")
}

model Teacher {
  id                  String             @id @default(uuid()) @db.Char(36)
  userId              String             @map("user_id") @db.Char(36)
  schoolId            String             @map("school_id") @db.Char(36)
  employeeId          String             @map("employee_id") @db.Char(36)
  department          String?            @db.VarChar(7)
  subjects            String?            @db.LongText
  createdAt           DateTime           @map("created_at") @db.DateTime(0)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.DateTime(0)
  archived_at         DateTime?          @db.DateTime(0)
  archived_by         String?            @db.Char(36)
  archive_reason      String?            @db.Text
  original_identifier Int?
  shift               String             @db.VarChar(8)
  salary              Int?
  status              String             @db.VarChar(6)
  academic_year_id    String?            @db.Char(36)
  assignments         Assignment[]
  classTeachers       ClassTeacher[]
  classes             Class[]
  courses             Course[]
  learningMaterials   LearningMaterial[]
  schools             School             @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_teachers_school_id")
  profile             Profile            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_teachers_user_id")
  timetableSlots      TimetableSlot[]

  @@index([schoolId], map: "idx_teachers_school_id")
  @@index([userId], map: "idx_teachers_user_id")
  @@map("teachers")
}

model Student {
  id                  String                 @id @default(uuid()) @db.Char(36)
  userId              String                 @map("user_id") @db.Char(36)
  schoolId            String                 @map("school_id") @db.Char(36)
  enrollmentNumber    String                 @map("enrollment_number") @db.VarChar(17)
  dateOfBirth         DateTime?              @map("date_of_birth") @db.Date
  grade               String?                @db.VarChar(13)
  parentId            String?                @map("parent_id") @db.Char(36)
  createdAt           DateTime               @map("created_at") @db.DateTime(0)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.DateTime(0)
  archived_at         DateTime?              @db.DateTime(0)
  archived_by         String?                @db.Char(36)
  archive_reason      String?                @db.Text
  original_identifier String?                @db.VarChar(10)
  gender              String?                @db.VarChar(6)
  start_date          DateTime?              @db.Date
  section             String?                @db.VarChar(1)
  academic_year_id    String?                @db.Char(36)
  region              String?                @db.VarChar(15)
  city                String?                @db.VarChar(8)
  district            String?                @db.VarChar(8)
  address             String?                @db.VarChar(10)
  parent_name         String?                @db.VarChar(7)
  parent_phone        String?                @db.VarChar(16)
  parent_relationship String?                @db.VarChar(6)
  emergency_contact   BigInt?
  country             String?                @db.VarChar(10)
  assignments         AssignmentSubmission[]
  attendance          Attendance[]
  classStudents       ClassStudent[]
  exam_unlocks        exam_unlocks[]
  exams               exams[]
  grades              Grade[]
  invoices            Invoice[]
  parentStudents      ParentStudent[]
  studentFeeOverrides StudentFeeOverride[]
  schools             School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_students_school_id")
  profile             Profile                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_students_user_id")

  @@index([schoolId], map: "idx_students_school_id")
  @@index([userId], map: "idx_students_user_id")
  @@map("students")
}

model Parent {
  id             String   @id @default(uuid()) @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  schoolId       String   @map("school_id") @db.Char(36)
  phone          BigInt
  address        String?  @db.Text
  occupation     String?  @db.Text
  createdAt      DateTime @map("created_at") @db.DateTime(0)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(0)
  archived_at    String?  @db.Text
  archived_by    String?  @db.Char(36)
  archive_reason String?  @db.Text
  schools        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_parents_school_id")
  profile        Profile  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_parents_user_id")

  @@index([schoolId], map: "idx_parents_school_id")
  @@index([userId], map: "idx_parents_user_id")
  @@map("parents")
}

model Class {
  id              String           @id @default(uuid()) @db.Char(36)
  name            String           @db.VarChar(32)
  grade           String?          @db.VarChar(2)
  section         String?          @db.VarChar(2)
  schoolId        String           @map("school_id") @db.Char(36)
  teacherId       String?          @map("teacher_id") @db.Char(36)
  capacity        Int
  createdAt       DateTime         @map("created_at") @db.DateTime(0)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.DateTime(0)
  education_level String?          @db.Text
  program         String?          @db.VarChar(6)
  level_label     String?          @db.VarChar(8)
  assignments     Assignment[]
  attendance      Attendance[]
  class_fees      class_fees[]
  classStudents   ClassStudent[]
  class_subjects  class_subjects[]
  classTeachers   ClassTeacher[]
  schools         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_classes_school_id")
  teacher         Teacher?         @relation(fields: [teacherId], references: [id], onUpdate: Restrict, map: "fk_classes_teacher_id")
  exams           exams[]
  timetableSlots  TimetableSlot[]

  @@index([schoolId], map: "idx_classes_school_id")
  @@index([teacherId], map: "idx_classes_teacher_id")
  @@map("classes")
}

model Course {
  id                String             @id @default(uuid()) @db.Char(36)
  name              String             @db.VarChar(9)
  code              String             @db.VarChar(9)
  description       String?            @db.VarChar(14)
  schoolId          String             @map("school_id") @db.Char(36)
  teacherId         String?            @map("teacher_id") @db.Char(36)
  credits           Int
  createdAt         DateTime           @map("created_at") @db.DateTime(0)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.DateTime(0)
  assignments       Assignment[]
  schools           School             @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_courses_school_id")
  teacher           Teacher?           @relation(fields: [teacherId], references: [id], onUpdate: Restrict, map: "fk_courses_teacher_id")
  grades            Grade[]
  learningMaterials LearningMaterial[]
  timetableSlots    TimetableSlot[]

  @@index([schoolId], map: "idx_courses_school_id")
  @@index([teacherId], map: "idx_courses_teacher_id")
  @@map("courses")
}

model ClassStudent {
  id         String   @id @default(uuid()) @db.Char(36)
  classId    String   @map("class_id") @db.Char(36)
  studentId  String   @map("student_id") @db.Char(36)
  enrolledAt DateTime @map("enrolled_at") @db.DateTime(0)
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_class_students_class_id")
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_class_students_student_id")

  @@index([classId], map: "idx_class_students_class_id")
  @@index([studentId], map: "idx_class_students_student_id")
  @@map("class_students")
}

model ClassTeacher {
  id         String    @id @default(uuid()) @db.Char(36)
  classId    String    @map("class_id") @db.Char(36)
  teacherId  String    @map("teacher_id") @db.Char(36)
  role       String?   @db.VarChar(50)
  assignedAt DateTime? @map("assigned_at") @db.DateTime(0)
  class      Class     @relation(fields: [classId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_class_teachers_class")
  teacher    Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_class_teachers_teacher")

  @@unique([classId, teacherId], map: "class_teacher_uniq")
  @@index([teacherId], map: "fk_class_teachers_teacher")
  @@map("class_teachers")
}

model ParentStudent {
  id           String   @id @default(uuid()) @db.Char(36)
  parentId     String   @map("parent_id") @db.Char(36)
  studentId    String   @map("student_id") @db.Char(36)
  relationship String   @db.VarChar(6)
  createdAt    DateTime @map("created_at") @db.DateTime(0)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_parent_students_student_id")

  @@index([studentId], map: "idx_parent_students_student_id")
  @@map("parent_students")
}

model Attendance {
  id        String   @id @default(uuid()) @db.Char(36)
  studentId String   @map("student_id") @db.Char(36)
  classId   String   @map("class_id") @db.Char(36)
  date      DateTime @db.Date
  status    String   @db.VarChar(7)
  notes     String?  @db.VarChar(60)
  markedBy  String?  @map("marked_by") @db.Char(36)
  createdAt DateTime @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_attendance_class_id")
  marker    Profile? @relation("AttendanceMarkedBy", fields: [markedBy], references: [id], onUpdate: Restrict, map: "fk_attendance_marked_by")
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_attendance_student_id")

  @@index([classId], map: "idx_attendance_class_id")
  @@index([markedBy], map: "idx_attendance_marked_by")
  @@index([studentId], map: "idx_attendance_student_id")
  @@map("attendance")
}

model Grade {
  id        String   @id @default(uuid()) @db.Char(36)
  studentId String   @map("student_id") @db.Char(36)
  courseId  String   @map("course_id") @db.Char(36)
  gradeType String   @map("grade_type") @db.VarChar(10)
  title     String   @db.VarChar(7)
  score     Int
  maxScore  Int      @map("max_score")
  weight    Int
  gradedBy  String?  @map("graded_by") @db.Char(36)
  gradedAt  DateTime @map("graded_at") @db.DateTime(0)
  notes     String?  @db.VarChar(21)
  createdAt DateTime @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_grades_course_id")
  grader    Profile? @relation("GradeGradedBy", fields: [gradedBy], references: [id], onUpdate: Restrict, map: "fk_grades_graded_by")
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_grades_student_id")

  @@index([courseId], map: "idx_grades_course_id")
  @@index([gradedBy], map: "idx_grades_graded_by")
  @@index([studentId], map: "idx_grades_student_id")
  @@map("grades")
}

model TimetableSlot {
  id        String    @id @default(uuid()) @db.Char(36)
  classId   String    @map("class_id") @db.Char(36)
  courseId  String?   @map("course_id") @db.Char(36)
  teacherId String?   @map("teacher_id") @db.Char(36)
  dayOfWeek Int?      @map("day_of_week")
  startTime DateTime? @map("start_time") @db.Time(0)
  endTime   DateTime? @map("end_time") @db.Time(0)
  room      String?   @db.VarChar(100)
  createdAt DateTime? @map("created_at") @db.DateTime(0)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.DateTime(0)
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_timetable_class")
  course    Course?   @relation(fields: [courseId], references: [id], onUpdate: Restrict, map: "fk_timetable_course")
  teacher   Teacher?  @relation(fields: [teacherId], references: [id], onUpdate: Restrict, map: "fk_timetable_teacher")

  @@index([courseId], map: "fk_timetable_course")
  @@index([teacherId], map: "fk_timetable_teacher")
  @@index([classId], map: "timetable_class_idx")
  @@index([dayOfWeek], map: "timetable_day_idx")
  @@map("timetable_slots")
}

model Invoice {
  id             String           @id @default(uuid()) @db.Char(36)
  studentId      String           @map("student_id") @db.Char(36)
  schoolId       String           @map("school_id") @db.Char(36)
  invoiceNumber  String           @map("invoice_number") @db.VarChar(15)
  title          String           @db.VarChar(25)
  description    String?          @db.VarChar(63)
  amount         Decimal          @db.Decimal(14, 2)
  dueDate        DateTime         @map("due_date") @db.Date
  paidDate       DateTime?        @map("paid_date") @db.Date
  status         String           @db.VarChar(14)
  paymentMethod  String?          @map("payment_method") @db.VarChar(12)
  createdAt      DateTime         @map("created_at") @db.DateTime(0)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.DateTime(0)
  amountPaid     Decimal          @map("amount_paid") @db.Decimal(14, 2)
  amountWaived   Decimal          @default(0.00) @map("amount_waived") @db.Decimal(14, 2)
  cancellationType   String?      @map("cancellation_type") @db.VarChar(30)
  cancellationReason String?      @map("cancellation_reason") @db.Text
  cancellationNote   String?       @map("cancellation_note") @db.Text
  cancelledAt        DateTime?     @map("cancelled_at") @db.DateTime(0)
  cancelledBy        String?       @map("cancelled_by") @db.Char(36)
  relatedInvoiceId   String?       @map("related_invoice_id") @db.Char(36)
  currency       String           @db.VarChar(3)
  billing_period String?          @db.VarChar(7)
  schools        School           @relation(fields: [schoolId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_invoices_school_id")
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_invoices_student_id")
  cancellationAuthor Profile?    @relation("InvoiceCancelledBy", fields: [cancelledBy], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "fk_invoices_cancelled_by")
  relatedInvoice Invoice?         @relation("InvoiceDuplicateReference", fields: [relatedInvoiceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_invoices_related_invoice_id")
  duplicateInvoices Invoice[]     @relation("InvoiceDuplicateReference")
  paymentHistory PaymentHistory[]
  refunds        InvoiceRefund[]

  @@index([schoolId], map: "idx_invoices_school_id")
  @@index([studentId], map: "idx_invoices_student_id")
  @@index([cancelledBy], map: "idx_invoices_cancelled_by")
  @@index([relatedInvoiceId], map: "idx_invoices_related_invoice_id")
  @@map("invoices")
}

model Assignment {
  id             String                 @id @default(uuid()) @db.Char(36)
  title          String                 @db.VarChar(4)
  description    String                 @db.VarChar(7)
  courseId       String                 @map("course_id") @db.Char(36)
  classId        String?                @map("class_id") @db.Char(36)
  teacherId      String?                @map("teacher_id") @db.Char(36)
  dueDate        DateTime               @map("due_date") @db.DateTime(0)
  maxScore       Int                    @map("max_score")
  assignmentType String                 @map("assignment_type") @db.VarChar(8)
  status         String                 @db.VarChar(9)
  attachments    String?                @db.Text
  createdAt      DateTime               @map("created_at") @db.DateTime(0)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.DateTime(0)
  submissions    AssignmentSubmission[]
  class          Class?                 @relation(fields: [classId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_assignments_class_id")
  course         Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_assignments_course_id")
  teacher        Teacher?               @relation(fields: [teacherId], references: [id], onUpdate: Restrict, map: "fk_assignments_teacher_id")

  @@index([classId], map: "idx_assignments_class_id")
  @@index([courseId], map: "idx_assignments_course_id")
  @@index([teacherId], map: "idx_assignments_teacher_id")
  @@map("assignments")
}

model AssignmentSubmission {
  id             String     @id @default(uuid()) @db.Char(36)
  assignmentId   String     @map("assignment_id") @db.Char(36)
  studentId      String     @map("student_id") @db.Char(36)
  submissionText String?    @map("submission_text") @db.Text
  attachments    String?    @db.LongText
  score          Decimal?   @db.Decimal(10, 2)
  feedback       String?    @db.Text
  submittedAt    DateTime?  @map("submitted_at") @db.DateTime(0)
  gradedAt       DateTime?  @map("graded_at") @db.DateTime(0)
  gradedBy       String?    @map("graded_by") @db.Char(36)
  status         String     @default("pending") @db.VarChar(20)
  createdAt      DateTime?  @map("created_at") @db.DateTime(0)
  updatedAt      DateTime?  @updatedAt @map("updated_at") @db.DateTime(0)
  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_assignment_submissions_assign")
  grader         Profile?   @relation("SubmissionGradedBy", fields: [gradedBy], references: [id], onUpdate: Restrict, map: "fk_assignment_submissions_gradedby")
  student        Student    @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_assignment_submissions_student")

  @@unique([assignmentId, studentId], map: "assignment_student_uniq")
  @@index([gradedBy], map: "fk_assignment_submissions_gradedby")
  @@index([studentId], map: "fk_assignment_submissions_student")
  @@map("assignment_submissions")
}

model LearningMaterial {
  id          String   @id @default(uuid()) @db.Char(36)
  courseId    String   @map("course_id") @db.Char(36)
  teacherId   String   @map("teacher_id") @db.Char(36)
  title       String   @db.VarChar(31)
  description String   @db.VarChar(0)
  fileUrl     String   @map("file_url") @db.VarChar(172)
  fileName    String   @map("file_name") @db.Char(36)
  fileType    String   @map("file_type") @db.VarChar(71)
  fileSize    Int      @map("file_size")
  createdAt   DateTime @map("created_at") @db.DateTime(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(0)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_learning_materials_course_id")
